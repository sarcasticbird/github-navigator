{
  "name": "github-navigator",
  "version": "1.2.0",
  "private": true,
  "description": "Firefox/Zen Browser extension for quick access to GitHub orgs and repos.",
  "scripts": {
    "lint": "web-ext lint --source-dir src",
    "start": "web-ext run --source-dir src --target firefox-desktop",
    "build": "web-ext build --source-dir src --artifacts-dir dist --overwrite-dest"
  },
  "devDependencies": {
    "web-ext": "8.10.0"
  }
}
